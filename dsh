#!/usr/bin/env bash
# dsh quick launcher (Caddy edition).
#
#   dsh              start dsh locally (equivalent to `dsh web`, foreground)
#   dsh --lan        ensure local dsh is up, start the Caddy https proxy,
#                    print the LAN address
#   dsh --lan-stop   stop the Caddy https proxy (local dsh keeps running)
#   dsh --stop       stop the Caddy proxy AND the local dsh on :3080
#   dsh <anything>   pass through to the real dsh CLI (e.g. `dsh web --help`)
#
# v2 (native Caddy): no Docker involved. Port layout:
#   dsh (node)       127.0.0.1:3080  plain http, loopback only
#   caddy            *:3081          https only, LAN entry (any Host on this
#                                    port proxies to dsh, like the old nginx
#                                    `server_name _`; plaintext is refused)
# URL: https://<LAN_IP>:3081 — HTTPS only, no plaintext fallback.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DEPLOY_DIR="$(dirname "$SCRIPT")"
DSH_HOME_ROOT="${DSH_HOME:-$HOME/.dsh}"
STATE_DIR="${DSH_STATE_DIR:-$DSH_HOME_ROOT/dsh-lan-manager}"
CADDY_DIR="$STATE_DIR/caddy"
CADDY_CONF="$CADDY_DIR/Caddyfile"
CADDY_PID="$CADDY_DIR/caddy.pid"
CADDY_LOG="$CADDY_DIR/caddy.log"
CADDY_RUN_LOG="$CADDY_DIR/caddy-run.log"
DSH_LOCAL_LOG="$STATE_DIR/dsh-local.log"

# The real dsh CLI (npm/npx install). Override with DSH_REAL_BIN; otherwise
# find it in the npx cache. Caddy binary: default to the system one, override
# with DSH_CADDY_BIN.
if [ -n "${DSH_REAL_BIN:-}" ]; then
    REAL_DSH="$DSH_REAL_BIN"
else
    REAL_DSH="$(ls -d "$HOME"/.npm/_npx/*/node_modules/.bin/dsh 2>/dev/null | head -1 || true)"
fi
if [ -z "$REAL_DSH" ] || [ ! -x "$REAL_DSH" ]; then
    echo "[dsh] ERROR: real dsh CLI not found; set DSH_REAL_BIN to the npx-installed dsh" >&2
    exit 1
fi
CADDY_BIN="${DSH_CADDY_BIN:-/usr/bin/caddy}"

# External LAN endpoint (https). Local dsh bind port is separate so caddy can
# own the external port on all interfaces. LAN_IP is auto-detected at startup
# (env DSH_LAN_IP wins), so a router-restart IP change is picked up on the
# next `dsh --lan`; gen-cert.sh then re-signs the cert for the new IP.
detect_lan_ip() {
    local ip
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    if [ -z "$ip" ]; then
        ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -1 || true)
    fi
    [ -n "$ip" ] || ip=127.0.0.1
    echo "$ip"
}

LAN_IP="${DSH_LAN_IP:-$(detect_lan_ip)}"
PORT="${DSH_PORT:-3081}"
LOCAL_PORT="${DSH_LOCAL_PORT:-3080}"
TAILSCALE_PORT="${DSH_TAILSCALE_PORT:-3082}"

# Tailscale MagicDNS name (e.g. <hostname>.tail<tailnet>.ts.net): when
# `tailscale serve` fronts dsh, the browser-trust fence sees that host in
# the Host header and would 403 — declare it as a trusted host. Empty when
# Tailscale is not running.
ts_trusted_host() {
    command -v tailscale >/dev/null 2>&1 || return 0
    local name
    name=$(tailscale status --json 2>/dev/null | python3 -c \
        "import json,sys
try:
    d=json.load(sys.stdin)
    print((d.get('Self',{}).get('DNSName','') or '').rstrip('.'))
except Exception: pass" 2>/dev/null || true)
    [ -n "$name" ] && echo "--trusted-host $name"
}
TRUSTED_HOST_ARGS="$(ts_trusted_host)"

is_local_up() {
    curl -s --noproxy '*' -o /dev/null -m 2 "http://127.0.0.1:$LOCAL_PORT/"
}

is_https_up() {
    curl -sk --noproxy '*' -o /dev/null -m 2 "https://$LAN_IP:$PORT/"
}

caddy_pid() {
    [ -f "$CADDY_PID" ] && cat "$CADDY_PID" 2>/dev/null || true
}

caddy_is_ours() {
    local pid cmdline
    pid="$(caddy_pid)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # A stale pidfile can point at a reused pid or at a user-started caddy.
    # Only accept a live process whose cmdline contains OUR Caddyfile; when
    # /proc is unavailable, refuse to guess (never signal a foreign process).
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    [ -n "$cmdline" ] && printf '%s' "$cmdline" | grep -Fq -- "$CADDY_CONF"
}

caddy_running() {
    caddy_is_ours
}

caddy_start() {
    mkdir -p "$CADDY_DIR" "$DEPLOY_DIR/caddy/certs" 2>/dev/null || true
    if [ ! -f "$CADDY_CONF" ] && [ -f "$DEPLOY_DIR/caddy/Caddyfile" ]; then
        cp "$DEPLOY_DIR/caddy/Caddyfile" "$CADDY_CONF"
    fi
    if caddy_running; then
        echo "[dsh] caddy proxy already running (pid $(cat "$CADDY_PID"))"
        return 0
    fi

    # A live pid in OUR pidfile that does not run OUR Caddyfile belongs to
    # someone else. Drop the stale pointer but never signal that process.
    local stale_pid
    stale_pid="$(caddy_pid)"
    if [ -n "$stale_pid" ] && kill -0 "$stale_pid" 2>/dev/null && ! caddy_is_ours; then
        echo "[dsh] pid $stale_pid is not the dsh-lan caddy; ignoring it" >&2
        rm -f "$CADDY_PID"
    fi

    echo "[dsh] starting caddy https proxy on $LAN_IP:$PORT ..."
    rm -f "$CADDY_PID" "$CADDY_RUN_LOG"
    # Keep caddy's own data/config out of $HOME; export deploy root and port
    # so the Caddyfile's {$DSH_*} placeholders resolve.
    DSH_DEPLOY_DIR="$DEPLOY_DIR" \
    DSH_CADDY_DIR="$CADDY_DIR" \
    DSH_PORT="$PORT" \
    DSH_LOCAL_PORT="$LOCAL_PORT" \
    DSH_TAILSCALE_PORT="$TAILSCALE_PORT" \
    XDG_DATA_HOME="$CADDY_DIR/data" \
    XDG_CONFIG_HOME="$CADDY_DIR/config" \
        nohup "$CADDY_BIN" run --config "$CADDY_CONF" --adapter caddyfile \
            >>"$CADDY_RUN_LOG" 2>&1 &
    echo $! > "$CADDY_PID"
    disown 2>/dev/null || true

    for _ in $(seq 1 30); do
        if is_https_up; then
            echo "[dsh] caddy ready (pid $(cat "$CADDY_PID"))"
            return 0
        fi
        if ! kill -0 "$(cat "$CADDY_PID")" 2>/dev/null; then
            echo "[dsh] ERROR: caddy exited; see $CADDY_RUN_LOG" >&2
            exit 1
        fi
        sleep 0.5
    done
    echo "[dsh] ERROR: https://$LAN_IP:$PORT/ not answering; see $CADDY_RUN_LOG" >&2
    exit 1
}

caddy_stop() {
    local pid
    pid="$(caddy_pid)"
    if caddy_is_ours; then
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.25
        done
        rm -f "$CADDY_PID"
        echo "[dsh] caddy proxy stopped"
    else
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "[dsh] pid $pid is not the dsh-lan caddy; leaving it alone" >&2
        fi
        rm -f "$CADDY_PID"
        echo "[dsh] caddy proxy not running"
    fi
}

lan_start() {
    local started_here=0
    mkdir -p "$STATE_DIR"

    if ! is_local_up; then
        echo "[dsh] local dsh not running — starting in background on 127.0.0.1:$LOCAL_PORT (log: $DSH_LOCAL_LOG)"
        nohup "$REAL_DSH" web --port "$LOCAL_PORT" $TRUSTED_HOST_ARGS >"$DSH_LOCAL_LOG" 2>&1 &
        started_here=1
        for _ in $(seq 1 30); do
            is_local_up && break
            sleep 1
        done
        if ! is_local_up; then
            echo "[dsh] ERROR: dsh did not start; see $DSH_LOCAL_LOG" >&2
            exit 1
        fi
    fi

    # Keep the TLS cert in step with the (possibly changed) LAN IP: gen-cert
    # no-ops when the cert already covers the current IP; if it regenerated
    # (exit 10) the running caddy must restart to load the new cert.
    if DSH_CERT_DIR="$CADDY_DIR/certs" "$DEPLOY_DIR/gen-cert.sh"; then
        :
    else
        rc=$?
        if [ "$rc" = 10 ]; then
            echo "[dsh] TLS cert regenerated for $LAN_IP — restarting caddy"
            caddy_stop
        elif [ "$rc" != 0 ]; then
            echo "[dsh] WARNING: cert regeneration failed ($rc); using existing cert" >&2
        fi
    fi

    caddy_start

    echo
    echo "  dsh LAN:  https://$LAN_IP:$PORT/"
    echo "  (LAN cert is signed by the local CA — install $CADDY_DIR/certs/ca/ca.crt on devices to remove the browser warning; https only, plain http no longer served)"
    echo
    if [ "$started_here" = 1 ]; then
        echo "[dsh] local dsh running in background; log: $DSH_LOCAL_LOG"
    else
        echo "[dsh] existing local dsh detected; proxy attached"
    fi
}

lan_stop() {
    caddy_stop
}

stop_local_dsh() {
    local pid cmdline
    pid=$(ss -tlnp 2>/dev/null | grep "127.0.0.1:$LOCAL_PORT" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
    if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        if ! printf '%s' "$cmdline" | grep -Fq -- "dsh web"; then
            echo "[dsh] process on 127.0.0.1:$LOCAL_PORT (pid $pid) is not dsh; leaving it alone" >&2
            return 0
        fi
    fi
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        echo "[dsh] stopped local dsh (pid $pid, port $LOCAL_PORT)"
    else
        echo "[dsh] no local dsh found on 127.0.0.1:$LOCAL_PORT"
    fi
}

case "${1:-}" in
    --lan)
        lan_start
        ;;
    --lan-stop)
        lan_stop
        ;;
    --stop)
        # Stop the Caddy proxy first, then the local dsh on port $LOCAL_PORT.
        lan_stop
        stop_local_dsh
        ;;
    "")
        if is_local_up; then
            echo "[dsh] dsh already running at http://127.0.0.1:$LOCAL_PORT/ (use 'dsh --lan' to expose it)"
            exit 0
        fi
        exec "$REAL_DSH" web --port "$LOCAL_PORT" $TRUSTED_HOST_ARGS
        ;;
    *)
        exec "$REAL_DSH" "$@"
        ;;
esac