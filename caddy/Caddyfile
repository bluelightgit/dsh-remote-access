# dsh LAN https proxy — native Caddy.
#
# This is the portable default template. At runtime dsh-lan-manager copies it
# into <dsh-home>/dsh-lan-manager/caddy/Caddyfile and rewrites that copy with
# the user's access-control settings. Never put machine-specific credentials
# in this template.
#
# Topology:
#   LAN clients -> https://<LAN_IP>:{$DSH_PORT}
#   Tailscale    -> https://<host>.ts.net -> tailscaled -> http://127.0.0.1:{$DSH_TAILSCALE_PORT}
#   Caddy        -> dsh at 127.0.0.1:{$DSH_LOCAL_PORT}
#
# Runtime paths under {$DSH_CADDY_DIR}; static CA install page stays in the
# deploy tree under {$DSH_DEPLOY_DIR}.
{
admin off
auto_https off
grace_period 3s
}

# ── LAN entry: external HTTPS port ────────────────────────────────────────
https://:{$DSH_PORT} {
tls {$DSH_CADDY_DIR}/certs/dsh.crt {$DSH_CADDY_DIR}/certs/dsh.key

handle /ca.crt {
root * {$DSH_CADDY_DIR}/certs/ca
header Content-Type "application/x-x509-ca-cert"
file_server
}

handle {
reverse_proxy 127.0.0.1:{$DSH_LOCAL_PORT} {
transport http {
dial_timeout 10s
keepalive off
}
header_up Host 127.0.0.1:{$DSH_LOCAL_PORT}
header_up Origin "http://127.0.0.1:{$DSH_LOCAL_PORT}"
}
}

encode gzip

log {
output file {$DSH_CADDY_DIR}/caddy.log
level INFO
}
}

# ── Tailscale entry: loopback HTTP only ───────────────────────────────────
http://:{$DSH_TAILSCALE_PORT} {
bind 127.0.0.1
@tailnet header Tailscale-User-Login *

handle @tailnet {
reverse_proxy 127.0.0.1:{$DSH_LOCAL_PORT} {
transport http {
dial_timeout 10s
keepalive off
}
header_up Host 127.0.0.1:{$DSH_LOCAL_PORT}
header_up Origin "http://127.0.0.1:{$DSH_LOCAL_PORT}"
}
}

handle {
respond "Funnel access is disabled because no Basic Auth credential is configured" 403
}

encode gzip
}
